<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lianxin.Fleet.Mac.ViewModels"
             x:Class="Lianxin.Fleet.Mac.Views.Center.DevicesPage">
    <Grid Margin="12,10,12,8" RowDefinitions="Auto,*">
        <Border Classes="panel" Padding="10,8,10,2" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel Classes="toolbar">
                    <TextBlock Text="常用" Classes="tool" />
                    <Button Content="▶ 运行脚本" Click="RunScriptClicked" ToolTip.Tip="对勾选的设备运行左侧选中的脚本" />
                    <Button Content="■ 停止脚本" Click="StopScriptClicked" ToolTip.Tip="停止勾选设备（未勾选时为全部设备）上的脚本" />
                    <Button Content="‖ 暂停脚本" Click="PauseScriptClicked" ToolTip.Tip="暂停勾选设备（未勾选时为全部设备）上的脚本，当前这一步执行完后停住" />
                    <Button Content="▷ 继续脚本" Click="ResumeScriptClicked" ToolTip.Tip="继续勾选设备（未勾选时为全部设备）上暂停的脚本" />
                    <Button Content="✓ 启动自动化" Classes="primary" Click="StartAutomationClicked"
                            ToolTip.Tip="为勾选的在线设备（未勾选时为全部在线设备）启动 WDA 控制" />
                    <Button Content="⊗ 停止自动化" Click="StopAutomationClicked" />
                    <Button Content="⟳ 重置 USB" Click="ResetUsbClicked" ToolTip.Tip="停止全部通道并重启 USB 设备服务（需要管理员密码）" />
                    <TextBlock Text="设备" Classes="tool" Margin="14,0,10,6" />
                    <Button Content="▣ 集控投屏" Classes="primary" Click="MirrorClicked" />
                    <TextBlock Text="无线" Classes="tool" Margin="14,0,10,6" />
                    <Button Content="无线中心" Click="WirelessClicked" />
                </WrapPanel>
                <WrapPanel Classes="toolbar">
                    <Button Content="一键配置" Click="SetupClicked" ToolTip.Tip="开发者模式、开发者镜像、安装 WDA" />
                    <Button Content="扫描设备" Click="DiscoverClicked" />
                    <Button Content="登记设备" Click="RegisterClicked" />
                    <Button Content="更多 ▾" AutomationProperties.Name="更多设备操作">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="安装应用到勾选设备…" Click="InstallClicked" />
                                <MenuItem Header="导出连接配置…" Click="ExportClicked" />
                                <MenuItem Header="打开应用批准目录" Click="OpenAppsClicked" />
                                <Separator />
                                <MenuItem Header="挂载开发者镜像（勾选设备）" Click="BatchMountClicked" />
                                <MenuItem Header="卸载开发者镜像（勾选设备）…" Click="BatchUnmountClicked" />
                                <MenuItem Header="重启勾选设备…" Click="BatchRestartClicked" />
                                <MenuItem Header="关机勾选设备…" Click="BatchShutdownClicked" />
                                <MenuItem Header="刷新电量" Click="RefreshBatteryClicked" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="240,*">
            <Grid Margin="0,0,10,0" RowDefinitions="*,*">
                <Border Classes="panel" Padding="10" Margin="0,0,0,10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="分组" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" x:Name="MultiGroupToggle" Content="多选" Click="MultiGroupClicked" Margin="0,0,6,0" />
                            <Button Grid.Column="2" Content="添加" Click="AddGroupClicked" AutomationProperties.Name="添加分组" />
                        </Grid>
                        <TextBox x:Name="GroupSearch" DockPanel.Dock="Top" PlaceholderText="搜索分组" Margin="0,6"
                                 TextChanged="GroupSearchChanged" AutomationProperties.Name="搜索分组" />
                        <ListBox x:Name="GroupList" SelectionChanged="GroupSelectionChanged" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="设备分组">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="把勾选设备移入此分组" Click="MoveToGroupClicked" />
                                    <MenuItem Header="删除分组（设备回到未分组）" Click="DeleteGroupClicked" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceGroupItem">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="muted" FontSize="11" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Classes="panel" Padding="10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="脚本" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="SortButton" Content="按名称" Margin="0,0,4,0" Click="SortScriptsClicked"
                                    AutomationProperties.Name="切换脚本排序" />
                            <Button Grid.Column="2" Content="添加" Click="AddScriptClicked" AutomationProperties.Name="添加脚本" />
                        </Grid>
                        <TextBox x:Name="ScriptSearch" DockPanel.Dock="Top" PlaceholderText="搜索脚本" Margin="0,6"
                                 TextChanged="ScriptSearchChanged" AutomationProperties.Name="搜索脚本" />
                        <TextBlock x:Name="NoScriptsLabel" DockPanel.Dock="Top" Text="暂无脚本，点「添加」新建。" Classes="muted" Margin="4,8" />
                        <ListBox x:Name="ScriptList" DoubleTapped="EditScriptClicked" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="脚本列表">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="运行到勾选设备" Click="RunScriptClicked" />
                                    <MenuItem Header="编辑…" Click="EditScriptClicked" />
                                    <MenuItem Header="删除" Click="DeleteScriptClicked" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScriptItem">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8" ColumnDefinitions="Auto,260,Auto,Auto,Auto,Auto,Auto,*">
                    <TextBlock Text="搜索" Classes="tool" Margin="2,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="SearchInput" PlaceholderText="设备 ID / ECID / 别名 / 名称"
                             AutomationProperties.Name="搜索设备" />
                    <Button Grid.Column="2" Content="搜索" Click="SearchClicked" Margin="6,0,16,0" />
                    <TextBlock Grid.Column="3" Text="列表" Classes="tool" Margin="2,0,8,0" />
                    <Button Grid.Column="4" x:Name="SelectAllButton" Content="☐ 全选" Click="SelectAllClicked" Margin="0,0,6,0" />
                    <Button Grid.Column="5" x:Name="ColumnsButton" Content="列设置" Click="ColumnsClicked" Margin="0,0,6,0" />
                    <Button Grid.Column="6" Content="更多 ▾" AutomationProperties.Name="更多列表操作">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="反选" Click="InvertSelectionClicked" />
                                <MenuItem Header="只勾选在线设备" Click="SelectOnlineClicked" />
                                <MenuItem Header="复制勾选设备的 ID" Click="CopyIdsClicked" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Border Grid.Column="7" Classes="chip neutral" HorizontalAlignment="Right" Margin="0">
                        <TextBlock x:Name="CountLabel" Text="0 台" />
                    </Border>
                </Grid>
                <Grid>
                    <DataGrid x:Name="DeviceGrid" x:DataType="vm:DeviceRow" IsReadOnly="True" SelectionMode="Extended"
                              CanUserReorderColumns="True" DoubleTapped="GridDoubleClicked" AutomationProperties.Name="设备列表">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="设备详情…" Click="DetailsClicked" FontWeight="SemiBold" />
                                <MenuItem Header="设置别名…" Click="AliasClicked" />
                                <MenuItem Header="移到分组…" Click="MoveRowsClicked" />
                                <MenuItem Header="测试自动化" Click="TestAutomationClicked" />
                                <MenuItem Header="投屏查看" Click="MirrorClicked" />
                                <MenuItem Header="复制设备 ID" Click="CopyRowIdClicked" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="44" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DeviceRow">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" MinWidth="0"
                                                  AutomationProperties.Name="勾选设备" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="设备 ID" Binding="{Binding Udid}" Width="200" />
                            <DataGridTextColumn Header="别名" Binding="{Binding Alias}" Width="100" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110" />
                            <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="100" />
                            <DataGridTextColumn Header="系统" Binding="{Binding OsVersion}" Width="70" />
                            <DataGridTemplateColumn Header="电量" Width="76" SortMemberPath="BatteryLevel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DeviceRow">
                                        <TextBlock Text="{Binding Battery}" ToolTip.Tip="{Binding BatteryTip}" VerticalAlignment="Center"
                                                   Margin="12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ECID" Binding="{Binding Ecid}" Width="140" />
                            <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="90" />
                            <DataGridTextColumn Header="连接" Binding="{Binding Connection}" Width="76" />
                            <DataGridTextColumn Header="脚本" Binding="{Binding Script}" Width="100" />
                            <DataGridTemplateColumn Header="消息" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DeviceRow">
                                        <TextBlock Text="{Binding Message}" ToolTip.Tip="{Binding Message}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="自动化" Width="84">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DeviceRow">
                                        <Border Classes="badge" Classes.ready="{Binding AutomationReady}" Margin="6,0"
                                                ToolTip.Tip="{Binding AutomationTip}">
                                            <TextBlock Text="{Binding Automation}" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyLabel" Text="还没有设备。用数据线连接 iPhone、解锁并点「信任此电脑」，中控会自动登记。"
                               Classes="muted" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
