<UserControl x:Class="Lianxin.Fleet.Desktop.Views.Center.AgentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="AI 助手" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Foreground="#9DA4BE" Margin="0,6,0,8"
                       Text="用一句话描述要在手机上完成的事。AI 会看截图、逐步点按，直到完成或无法继续。截图会发送给模型服务。" />
            <TextBlock Text="设备（需已启动自动化）" Style="{StaticResource SectionTitle}" />
            <ComboBox x:Name="DeviceBox" DisplayMemberPath="Label" />
            <TextBlock Text="任务说明" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="InstructionInput" Height="130" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000"
                     VerticalScrollBarVisibility="Auto" Text="打开设置，查看 iOS 版本号" />
            <TextBlock x:Name="ModelLabel" Foreground="#9DA4BE" FontSize="11" Margin="0,0,0,8" />
            <WrapPanel>
                <Button x:Name="StartButton" Content="▶ 开始" Click="StartClicked" Style="{StaticResource AccentButton}" />
                <Button x:Name="StopButton" Content="■ 停止" Click="StopClicked" IsEnabled="False" />
                <Button Content="清空记录" Click="ClearClicked" />
            </WrapPanel>
            <Border Style="{StaticResource PanelBox}" Margin="0,10,0,0">
                <TextBlock x:Name="ResultLabel" Text="还没有运行。" TextWrapping="Wrap" />
            </Border>
            <TextBlock Foreground="#7F86A3" FontSize="11" Margin="0,10,0,0"
                       Text="AI 不会自动输入密码、付款、发送消息或删除数据，除非任务说明明确要求。遇到登录、验证码等情况会停下并说明原因。" />
        </StackPanel>
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="执行记录" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <ListBox x:Name="LogList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Stamp}" Foreground="#7F86A3" Width="64" FontSize="11" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" Foreground="#8FB2FF" Width="40" FontSize="12" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
