<UserControl x:Class="Lianxin.Fleet.Desktop.Views.Center.SchedulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="定时任务" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Foreground="#9DA4BE" Margin="0,6,0,10"
                       Text="到点后按本机时间对目标设备运行脚本。只在中控运行期间生效；中控关闭期间错过的任务不会补跑。目标设备需要已启动自动化。" />
            <WrapPanel>
                <Button Content="新建" Click="AddClicked" Style="{StaticResource AccentButton}" />
                <Button Content="编辑" Click="EditClicked" />
                <Button Content="启用 / 停用" Click="ToggleClicked" />
                <Button Content="立即运行一次" Click="RunNowClicked" />
                <Button Content="删除" Click="DeleteClicked" />
            </WrapPanel>
            <TextBlock x:Name="LastLabel" Foreground="#B8B5E3" Margin="0,4,0,8" />
        </StackPanel>
        <DataGrid x:Name="ScheduleGrid" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="EditClicked">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="脚本" Binding="{Binding ScriptName}" Width="160" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="160" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="规则" Binding="{Binding Rule}" Width="*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="70" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="上次运行" Binding="{Binding LastRun}" Width="120" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
