<UserControl x:Class="Lianxin.Fleet.Desktop.Views.Center.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,10,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource PanelBox}" Padding="10,8,10,2" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="常用" Style="{StaticResource ToolLabel}" />
                    <Button Content="▶ 运行脚本" Click="RunScriptClicked" ToolTip="对勾选的设备运行左侧选中的脚本" />
                    <Button Content="■ 停止脚本" Click="StopScriptClicked" ToolTip="停止勾选设备（未勾选时为全部设备）上的脚本" />
                    <Button Content="‖ 暂停脚本" Click="PauseScriptClicked" ToolTip="暂停勾选设备（未勾选时为全部设备）上的脚本，当前这一步执行完后停住" />
                    <Button Content="▷ 继续脚本" Click="ResumeScriptClicked" ToolTip="继续勾选设备（未勾选时为全部设备）上暂停的脚本" />
                    <Button Content="✓ 启动自动化" Click="StartAutomationClicked" Style="{StaticResource AccentButton}"
                            ToolTip="为勾选的在线设备（未勾选时为全部在线设备）启动 WDA 控制" />
                    <Button Content="⊗ 停止自动化" Click="StopAutomationClicked" />
                    <Button Content="⟳ 重置 USB" Click="ResetUsbClicked" ToolTip="停止全部通道并重启 Apple Mobile Device Service（需要管理员授权）" />
                    <TextBlock Text="设备" Style="{StaticResource ToolLabel}" Margin="14,0,10,6" />
                    <Button Content="▣ 集控投屏" Click="MirrorClicked" Style="{StaticResource AccentButton}" />
                    <TextBlock Text="无线" Style="{StaticResource ToolLabel}" Margin="14,0,10,6" />
                    <Button Content="无线中心" Click="WirelessClicked" />
                </WrapPanel>
                <WrapPanel>
                    <Button Content="一键配置" Click="SetupClicked" ToolTip="开发者模式、开发者镜像、安装 WDA" />
                    <Button Content="扫描设备" Click="DiscoverClicked" />
                    <Button Content="登记设备" Click="RegisterClicked" />
                    <Button x:Name="ToolMoreButton" Content="更多 ▾" Click="ToolMoreClicked">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="安装应用到勾选设备…" Click="InstallClicked" />
                                <MenuItem Header="导出连接配置…" Click="ExportClicked" />
                                <MenuItem Header="打开应用批准目录" Click="OpenAppsClicked" />
                                <Separator />
                                <MenuItem Header="挂载开发者镜像（勾选设备）" Click="BatchMountClicked" />
                                <MenuItem Header="卸载开发者镜像（勾选设备）…" Click="BatchUnmountClicked" />
                                <MenuItem Header="重启勾选设备…" Click="BatchRestartClicked" />
                                <MenuItem Header="关机勾选设备…" Click="BatchShutdownClicked" />
                                <MenuItem Header="刷新电量" Click="RefreshBatteryClicked" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelBox}" Margin="0,0,0,10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock Text="分组" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox x:Name="MultiGroupToggle" Content="多选" Margin="0,0,8,0" Click="MultiGroupClicked" />
                                <Button Content="添加" Padding="8,3" MinHeight="24" Margin="0" Click="AddGroupClicked" AutomationProperties.Name="添加分组" />
                            </StackPanel>
                        </DockPanel>
                        <TextBox x:Name="GroupSearch" DockPanel.Dock="Top" TextChanged="GroupSearchChanged" ToolTip="搜索分组" />
                        <ListBox x:Name="GroupList" SelectionChanged="GroupSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="把勾选设备移入此分组" Click="MoveToGroupClicked" />
                                    <MenuItem Header="删除分组（设备回到未分组）" Click="DeleteGroupClicked" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="#8C93AE" FontSize="11" />
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource PanelBox}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock Text="脚本" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SortButton" Content="按名称" Padding="8,3" MinHeight="24" Margin="0,0,4,0" Click="SortScriptsClicked" />
                                <Button Content="添加" Padding="8,3" MinHeight="24" Margin="0" Click="AddScriptClicked" AutomationProperties.Name="添加脚本" />
                            </StackPanel>
                        </DockPanel>
                        <TextBox x:Name="ScriptSearch" DockPanel.Dock="Top" TextChanged="ScriptSearchChanged" ToolTip="搜索脚本" />
                        <TextBlock x:Name="NoScriptsLabel" DockPanel.Dock="Top" Text="暂无脚本，点「添加」新建。" Foreground="#8C93AE" Margin="4,8" />
                        <ListBox x:Name="ScriptList" MouseDoubleClick="EditScriptClicked" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="运行到勾选设备" Click="RunScriptClicked" />
                                    <MenuItem Header="编辑…" Click="EditScriptClicked" />
                                    <MenuItem Header="删除" Click="DeleteScriptClicked" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Detail}" Foreground="#8C93AE" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
            <DockPanel Grid.Column="1">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="搜索" Style="{StaticResource ToolLabel}" Margin="2,0,8,0" />
                    <TextBox x:Name="SearchInput" Width="260" Margin="0" KeyDown="SearchKeyDown" ToolTip="设备 ID / ECID / 别名 / 名称"
                             AutomationProperties.Name="搜索设备" />
                    <Button Content="搜索" Click="SearchClicked" Margin="6,0,16,0" />
                    <TextBlock Text="列表" Style="{StaticResource ToolLabel}" Margin="2,0,8,0" />
                    <Button x:Name="SelectAllButton" Content="☐ 全选" Click="SelectAllClicked" Margin="0,0,6,0" />
                    <Button x:Name="ColumnsButton" Content="列设置" Click="ColumnsClicked" Margin="0,0,6,0" />
                    <Button x:Name="ListMoreButton" Content="更多 ▾" Click="ListMoreClicked" Margin="0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="反选" Click="InvertSelectionClicked" />
                                <MenuItem Header="只勾选在线设备" Click="SelectOnlineClicked" />
                                <MenuItem Header="复制勾选设备的 ID" Click="CopyIdsClicked" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Border Style="{StaticResource Chip}" Background="#1F2433" BorderBrush="#3B425A" HorizontalAlignment="Right" Margin="0">
                        <TextBlock x:Name="CountLabel" Text="0 台" />
                    </Border>
                </DockPanel>
                <Grid>
                    <DataGrid x:Name="DeviceGrid" IsReadOnly="True" MouseDoubleClick="GridDoubleClicked">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="设备详情…" Click="DetailsClicked" FontWeight="SemiBold" />
                                <MenuItem Header="设置别名…" Click="AliasClicked" />
                                <MenuItem Header="移到分组…" Click="MoveRowsClicked" />
                                <MenuItem Header="测试自动化" Click="TestAutomationClicked" />
                                <MenuItem Header="投屏查看" Click="MirrorClicked" />
                                <MenuItem Header="复制设备 ID" Click="CopyRowIdClicked" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="设备 ID" Binding="{Binding Udid, Mode=OneWay}" Width="150" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="别名" Binding="{Binding Alias, Mode=OneWay}" Width="100" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=OneWay}" Width="110" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="型号" Binding="{Binding Model, Mode=OneWay}" Width="100" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="系统" Binding="{Binding OsVersion, Mode=OneWay}" Width="70" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="电量" Width="70" SortMemberPath="BatteryLevel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Battery}" ToolTip="{Binding BatteryTip}" Style="{StaticResource CellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ECID" Binding="{Binding Ecid, Mode=OneWay}" Width="140" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="分组" Binding="{Binding Group, Mode=OneWay}" Width="90" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="连接" Binding="{Binding Connection, Mode=OneWay}" Width="60" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="脚本" Binding="{Binding Script, Mode=OneWay}" Width="100" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="消息" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" Style="{StaticResource CellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="自动化" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge" CornerRadius="3" Padding="8,2" HorizontalAlignment="Left" Background="#3A3F52" ToolTip="{Binding AutomationTip}">
                                            <TextBlock Text="{Binding Automation}" FontSize="12" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding AutomationReady}" Value="True">
                                                <Setter TargetName="Badge" Property="Background" Value="#2E6B45" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyLabel" Text="还没有设备。用数据线连接 iPhone、解锁并点「信任此电脑」，中控会自动登记。"
                               Foreground="#9DA4BE" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
