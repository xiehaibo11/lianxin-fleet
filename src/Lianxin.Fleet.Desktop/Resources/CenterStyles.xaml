<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 中控界面：顶部标签、工具栏分组标题、深色表格与底部状态栏。基础控件样式来自 Styles.xaml。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Lianxin.Fleet;component/Resources/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- 应用级的 TextBlock 样式会进入下拉框等系统控件模板，因此不设颜色：文字颜色从窗口继承。 -->
    <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#DADCEB" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Box" Background="#222738" BorderBrush="#343B52" BorderThickness="1" CornerRadius="4" Padding="16,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#26345C" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#5B86F0" />
                            <Setter Property="Foreground" Value="#8FB2FF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#5B86F0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8C93AE" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0,10,6" />
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BorderBrush" Value="#5B86F0" />
        <Setter Property="Foreground" Value="#8FB2FF" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="#C9CDE0" />
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#E6E8F4" />
        <Setter Property="Margin" Value="0,4,14,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="#F1F2FA" />
        <Setter Property="Background" Value="#11151F" />
        <Setter Property="BorderBrush" Value="#394055" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,5,0,8" />
        <Setter Property="CaretBrush" Value="White" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#141823" />
        <Setter Property="RowBackground" Value="#171B27" />
        <Setter Property="AlternatingRowBackground" Value="#141823" />
        <Setter Property="Foreground" Value="#E6E8F4" />
        <Setter Property="BorderBrush" Value="#2C3245" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#262C3D" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#1D2230" />
        <Setter Property="Foreground" Value="#C9CDE0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="BorderBrush" Value="#2C3245" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#26345C" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#E6E8F4" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#233024" />
        <Setter Property="BorderBrush" Value="#3E6B47" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="PanelBox" TargetType="Border">
        <Setter Property="Background" Value="#151924" />
        <Setter Property="BorderBrush" Value="#2C3245" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
    </Style>
</ResourceDictionary>
